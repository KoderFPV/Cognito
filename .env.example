# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27018/cognito

# Weaviate Configuration
WEAVIATE_HTTP_HOST=localhost
WEAVIATE_HTTP_PORT=8083
WEAVIATE_GRPC_HOST=localhost
WEAVIATE_GRPC_PORT=50053
WEAVIATE_SECURE=false
WEAVIATE_API_KEY=cognito-key
ENABLE_VECTORIZERS=false

# Next.js Configuration
NODE_ENV=development
PORT=2137

# NextAuth Configuration
NEXTAUTH_SECRET=your-secret-key-change-in-production
NEXTAUTH_URL=http://localhost:2137

# E2E Tests Configuration
TEST_SERVER_URL=http://localhost:2137

# Ollama Configuration
OLLAMA_URL=http://localhost:2141/v1
OLLAMA_MODEL=speakleash/bielik-11b-v3.0-instruct:Q8_0

# LangSmith Configuration (optional - for tracing LangGraph)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=cognito

# Application Settings
# Add your application-specific environment variables here
